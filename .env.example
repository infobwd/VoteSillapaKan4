# Local/staging example only. Never commit credentials.
# APP_BASE must be an absolute URL path ending with /.
APP_BASE=/
# PHP reads these environment variables via the hosting environment (not from this file automatically).
VOTE_DB_HOST=127.0.0.1
VOTE_DB_PORT=3306
VOTE_DB_NAME=vote_staging
VOTE_DB_USER=replace_me
VOTE_DB_PASSWORD=replace_me
